{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 4,
		"minor": 3,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true
		},
		{
			"name": "linux-gcc-debug",
			"inherits": "base",
			"displayName": "linux_gcc_debug",
			"description": "Debug build with GCC (uses TGE_GCC_PATH or system GCC)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/gcc-Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/gcc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-gcc-release",
			"inherits": "base",
			"displayName": "linux_gcc_release",
			"description": "Release build with GCC (uses TGE_GCC_PATH or system GCC)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/gcc-Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/gcc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-gcc-relwithdebinfo",
			"inherits": "base",
			"displayName": "linux_gcc_relwithdebinfo",
			"description": "Optimised build with symbols, using GCC (uses TGE_GCC_PATH or system GCC)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/gcc-RelWithDebInfo",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/gcc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-gcc-ubsan",
			"inherits": "linux-gcc-relwithdebinfo",
			"displayName": "linux_gcc_ubsan",
			"description": "UndefinedBehaviorSanitizer with GCC, on top of RelWithDebInfo, asserts live",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"binaryDir": "${sourceDir}/build/gcc-ubsan",
			"cacheVariables": {
				"LKT_SANITIZER": "undefined",
				"TGE_DEBUG_ENABLED": "ON"
			}
		},
		{
			"name": "linux-gcc-asan",
			"inherits": "linux-gcc-relwithdebinfo",
			"displayName": "linux_gcc_asan",
			"description": "AddressSanitizer with GCC, on top of RelWithDebInfo, asserts live, ASan owns the heap",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"binaryDir": "${sourceDir}/build/gcc-asan",
			"cacheVariables": {
				"LKT_SANITIZER": "address",
				"TGE_DEBUG_ENABLED": "ON",
				"TGE_ENABLE_GLOBAL_ALLOCATOR": "OFF"
			}
		},
		{
			"name": "linux-gcc-asanubsan",
			"inherits": "linux-gcc-relwithdebinfo",
			"displayName": "linux_gcc_asanubsan",
			"description": "Address and UndefinedBehaviorSanitizer together with GCC, on top of RelWithDebInfo, asserts live, ASan owns the heap",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"binaryDir": "${sourceDir}/build/gcc-asanubsan",
			"cacheVariables": {
				"LKT_SANITIZER": "address,undefined",
				"TGE_DEBUG_ENABLED": "ON",
				"TGE_ENABLE_GLOBAL_ALLOCATOR": "OFF"
			}
		},
		{
			"name": "linux-gcc-tsan",
			"inherits": "linux-gcc-relwithdebinfo",
			"displayName": "linux_gcc_tsan",
			"description": "ThreadSanitizer with GCC, on top of RelWithDebInfo, asserts live, the system allocator",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"binaryDir": "${sourceDir}/build/gcc-tsan",
			"cacheVariables": {
				"LKT_SANITIZER": "thread",
				"TGE_DEBUG_ENABLED": "ON",
				"TGE_ENABLE_GLOBAL_ALLOCATOR": "OFF"
			}
		},
		{
			"name": "linux-clang-debug",
			"inherits": "base",
			"displayName": "linux_clang_debug",
