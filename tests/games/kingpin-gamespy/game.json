{
	"format": 2,
	"name": "Kingpin GameSpy Test",
	"protocol": "quake2",
	"text": { "encoding": "ascii7" },
	"//masters": "The test sets the port to its emulated master's.",
	"masters": [
		{ "host": "127.0.0.1", "port": 28900, "protocol": "gamespy1", "protocolOptions": { "masterGame": "kingpin" }, "portOffset": 10 }
	],
	"keys": {
		"hostname": "hostname",
		"map": "mapname",
		"maxPlayers": "maxclients",
		"password": "password"
	},
	"join": {
		"arguments": [ "+connect", "{address}" ],
		"passwordArguments": [ "+set", "password", "{password}", "+connect", "{address}" ],
		"password": { "maxLength": 63 }
	}
}
