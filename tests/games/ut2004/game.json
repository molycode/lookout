{
	"format": 1,
	"name": "UT2004 Test",
	"protocol": "unreal2",
	"queryPortOffset": 1,
	// Names colour their parts with ESC and three bytes of red, green and blue.
	"text": { "encoding": "utf8OrWindows1252", "colourCodes": { "escape": "\u001b", "codes": "rgb" } },
	// The test sets the port to its emulated master's.
	"masters": [ { "host": "127.0.0.1", "port": 28902 } ],
	"keys": {
		"hostname": "hostname",
		"map": "map",
		"numPlayers": "numplayers",
		"maxPlayers": "maxplayers",
		"password": "password",
		"mods": [ "gametype" ]
	},
	"join": {
		"arguments": [ "{address}" ],
		"passwordArguments": [ "{address}?password={password}" ],
		"password": { "maxLength": 63, "refusedCharacters": " ?#" }
	}
}
